model UsageLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")       // ✅ nullable — visiteurs non connectés
  apiKeyId     Int?     @map("api_key_id")    // ✅ nullable — appels sans clé
  modeleId     Int?     @map("modele_id")     // ✅ nullable — sécurité
  endpoint     String
  method       String   @default("POST")
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time")
  tokens       Int      @default(0)
  cost         Float    @default(0.0)
  ipAddress    String?  @map("ip_address")    // ✅ NOUVEAU
  metadata     Json?
  createdAt    DateTime @default(now())       @map("created_at")

  // Relations — optionnelles maintenant
  user   User?   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  modele Modele? @relation(fields: [modeleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
  @@index([modeleId])
  @@index([createdAt])
  @@index([ipAddress])  // ✅ NOUVEAU
  @@map("usage_logs")
}

// ============================================
// NEXTAUTH
// ============================================

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// INFO ENTREPRISE
// ============================================

model KMIA {
  id          Int      @id @default(autoincrement())
  name        String   @default("Komor-IA")
  slogan      String?
  description String?  @db.Text
  logo        String?
  email       String?
  phone       String?
  address     String?
  website     String?
  social      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("kmia")
}

model UserSettings {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  // Préférences d'affichage
  theme    String @default("light") // light, dark, auto
  language String @default("fr") // fr, en, ar, sw, zdj
  timezone String @default("Africa/Moroni")

  // Notifications
  emailNotifications Boolean @default(true) @map("email_notifications")
  usageAlerts        Boolean @default(true) @map("usage_alerts")
  monthlyReports     Boolean @default(true) @map("monthly_reports")
  securityAlerts     Boolean @default(true) @map("security_alerts")

  // Limites et quotas
  dailyRequestLimit     Int?   @map("daily_request_limit")
  monthlyBudgetLimit    Float? @map("monthly_budget_limit")
  quotaWarningThreshold Int    @default(80) @map("quota_warning_threshold") // %

  // API Defaults
  defaultModel     String? @map("default_model")
  defaultMaxTokens Int     @default(1000) @map("default_max_tokens")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

// Pour le Blog
enum BlogStatus {
  draft
  published
  archived
}

model Blog {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(500)
  slug        String     @unique
  excerpt     String?    @db.Text
  content     String     @db.LongText // Markdown
  coverImage  String?    @map("cover_image")
  category    String     @default("actualites")
  tags        Json?
  status      BlogStatus @default(draft)
  authorId    Int        @map("author_id")
  publishedAt DateTime?  @map("published_at")
  readTime    Int        @default(5) @map("read_time") // minutes
  views       Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@map("blogs")
}

// Pour la collece vocale 
enum VoicePhraseStatus {
  active
  inactive
  completed
}

enum VoiceRecordingStatus {
  pending
  validated
  rejected
}

enum Genre {
  homme
  femme
  autre
}

enum TrancheAge {
  moins18
  age18_25
  age26_35
  age36_50
  plus50
}

enum ZoneGeographique {
  urbain
  rural
}

enum Ile {
  grande_comore
  anjouan
  moheli
  mayotte
  diaspora
}

model VoicePhrase {
  id             Int               @id @default(autoincrement())
  text           String            @db.Text
  dialecte       Dialecte          @default(shingazidja)
  translation    String?           @db.Text
  difficulty     Int               @default(1)
  status         VoicePhraseStatus @default(active)
  maxRecordings  Int               @default(3) @map("max_recordings")
  recordingCount Int               @default(0) @map("recording_count")
  createdBy      Int               @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  creator    User             @relation(fields: [createdBy], references: [id])
  recordings VoiceRecording[]

  @@index([status])
  @@index([dialecte])
  @@map("voice_phrases")
}

model VoiceRecording {
  id            Int                  @id @default(autoincrement())
  phraseId      Int                  @map("phrase_id")
  userId        Int                  @map("user_id")
  audioUrl      String               @map("audio_url")
  publicId      String               @map("public_id")
  duration      Float                @default(0)
  status        VoiceRecordingStatus @default(pending)
  dialecte      Dialecte             @default(shingazidja)
  genre         Genre?
  trancheAge    TrancheAge?          @map("tranche_age")
  zone          ZoneGeographique?
  ile           Ile?
  nativeSpeaker Boolean              @default(true) @map("native_speaker")
  validatedBy   Int?                 @map("validated_by")
  validatedAt   DateTime?            @map("validated_at")
  rejectReason  String?              @map("reject_reason") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  phrase VoicePhrase @relation(fields: [phraseId], references: [id])
  user   User        @relation(fields: [userId], references: [id])

  @@unique([phraseId, userId])
  @@index([phraseId])
  @@index([userId])
  @@index([status])
  @@map("voice_recordings")
}

// Pour la traduction, extension avec de petites phrases
enum ContentType {
  article // Article de presse complet
  paragraph // Conte, histoire courte, paragraphe
  sentence // Phrase unique
}

// ============================================
// GAMIFICATION
// ============================================

model UserGamification {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique @map("user_id")
  points       Int       @default(0) // Points actuels
  totalPoints  Int       @default(0) @map("total_points") // Cumulé à vie (pour badges)
  level        Int       @default(1)
  streak       Int       @default(0) // Jours consécutifs actuels
  maxStreak    Int       @default(0) @map("max_streak") // Record de streak
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]
  badges       UserBadge[]

  @@index([userId])
  @@index([totalPoints]) // Pour le leaderboard
  @@map("user_gamification")
}

model PointTransaction {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  gamificationId Int      @map("gamification_id")
  action         String // 'sentence', 'paragraph', 'article', 'voice', 'streak_3', 'streak_7', 'streak_30'
  points         Int
  description    String?  @db.VarChar(255)
  refId          Int?     @map("ref_id") // ID de la traduction ou recording
  createdAt      DateTime @default(now()) @map("created_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamification UserGamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gamificationId])
  @@index([createdAt])
  @@map("point_transactions")
}

model UserBadge {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  gamificationId Int      @map("gamification_id")
  badge          String // 'first_contribution', 'debutant', 'actif', 'expert', 'maitre', 'streak_3', etc.
  earnedAt       DateTime @default(now()) @map("earned_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamification UserGamification @relation(fields: [gamificationId], references: [id], onDelete: Cascade)

  @@unique([userId, badge]) // Un badge unique par user
  @@index([userId])
  @@map("user_badges")
}


// Dataset

enum DatasetStatus {
  draft
  published
  archived
}

enum DatasetLicense {
  cc0
  cc_by
  cc_by_sa
  cc_by_nc
  mit
  apache2
  custom
}

enum DownloadType {
  direct
  external
  both
}

model Dataset {
  id           Int             @id @default(autoincrement())
  title        String          @db.VarChar(500)
  slug         String          @unique
  description  String          @db.LongText
  excerpt      String?         @db.Text
  coverImage   String?         @map("cover_image")
  tags         Json?
  language     String          @default("shi")
  domain       String?
  license      DatasetLicense  @default(cc_by)
  status       DatasetStatus   @default(draft)
  numExamples  Int             @default(0)  @map("num_examples")
  sizeInMb     Float           @default(0)  @map("size_in_mb")
  numDownloads Int             @default(0)  @map("num_downloads")
  downloadType DownloadType    @default(external) @map("download_type")
  downloadUrl  String?         @map("download_url")
  fileUrl      String?         @map("file_url")
  filePublicId String?         @map("file_public_id")
  format       String?
  version      String          @default("1.0.0")
  previewData  Json?           @map("preview_data")
  bibtex       String?         @db.Text
  authorId     Int             @map("author_id")
  publishedAt  DateTime?       @map("published_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt      @map("updated_at")

  author       User            @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@map("datasets")
}


// Forgot password 
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}



