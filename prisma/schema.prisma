// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

// enum UserRole {
//   admin
//   user
//   developer
//   journaliste
//   translator // Nouveau rôle pour les traducteurs
//   linguiste
// }
enum UserRole {
  admin
  user
  developer
  journaliste
  translator
  linguiste
  partner
}

enum Dialecte {
  shingazidja
  shindzuani
  shimwali
  shimaore
}

enum ModelStatus {
  development
  beta
  production
  deprecated
}

enum ProfilStatus {
  private
  public
}

enum ArticleStatus {
  draft // Brouillon
  pending // En attente de traduction
  in_progress // Traduction en cours
  completed // Traduction terminée
  verified // Traduction vérifiée
}

enum ArticleLanguage {
  fr // Français
  en // Anglais
  ar // Arabe
  sw // Swahili
  zdj // Comorien (Ngazidja)
  other
}

enum ArticleCategory {
  societe
  politique // politics
  economie // economy
  sport // sport
  sante // health
  education // education
  science // science
  histoire // history
  culture // culture
  religion // religion
  actualites // news
  litterature // literature
  autre // other
}

// ============================================
// MODÈLES PRINCIPAUX
// ============================================

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique
  hashPassword  String?   @map("hash_password")
  image         String?
  role          UserRole  @default(user)
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  profil            Profil?
  apiKeys           ApiKey[]
  usageLogs         UsageLog[]
  accounts          Account[]
  sessions          Session[]
  translations      Translation[] // Traductions faites par l'utilisateur
  translationEdits  TranslationEdit[] // Historique des modifications
  userSettings      UserSettings?
  blogs             Blog[]
  voicePhrases      VoicePhrase[]
  voiceRecordings   VoiceRecording[]
  userGamification  UserGamification?
  pointTransactions PointTransaction[]
  userBadges        UserBadge[]
  datasets Dataset[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@map("users")
}

model Profil {
  id        Int          @id @default(autoincrement())
  bio       String?      @db.Text
  location  String?
  website   String?
  phone     String?
  status    ProfilStatus @default(private)
  userId    Int          @unique @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profils")
}

model Modele {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String      @db.Text
  domaine     String
  version     String      @default("1.0.0")
  status      ModelStatus @default(development)
  endpoint    String?
  icon        String?     @default("Brain")
  color       String?     @default("blue")
  isPublic    Boolean     @default(true) @map("is_public")
  features    Json?
  pricing     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  apiKeys   ApiKey[]
  usageLogs UsageLog[]

  @@index([slug])
  @@index([status])
  @@map("modeles")
}

// ============================================
// SYSTÈME D'ARTICLES ET TRADUCTIONS
// ============================================

